rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ok() { return request.auth != null && me().status == 'active'; }
    function role(r) { return ok() && me().role == r; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{u} {
      // Own profile; admin sees all; faculty see only students assigned to them.
      allow read: if ok() && (request.auth.uid == u || me().role == 'admin'
                     || (me().role == 'faculty' && request.auth.uid in resource.data.get('facultyUids', [])));
      allow write: if role('admin');
      // A user may only clear their own must-change-password flag.
      allow update: if ok() && request.auth.uid == u && changed().hasOnly(['mustChange']) && request.resource.data.mustChange == false;
    }
    match /courses/{c} {
      allow read: if ok();
      allow write: if role('admin');
    }
    match /sessions/{s} {
      allow read: if ok() && (me().role == 'admin' || resource.data.studentUid == request.auth.uid
                     || resource.data.facultyUid == request.auth.uid);
      // Faculty records a session for a student assigned to them. It starts as "taught", never approved.
      allow create: if role('faculty')
        && request.resource.data.facultyUid == request.auth.uid
        && request.resource.data.status == 'taught'
        && request.resource.data.createdAt == request.time
        && request.resource.data.topicIds.size() > 0
        && request.resource.data.keys().hasOnly(['courseId','topicIds','studentUid','studentId','studentName',
             'facultyUid','facultyName','date','title','notes','status','createdAt'])
        && me().courses.hasAny([request.resource.data.courseId])
        && get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data
             .enrol[request.resource.data.courseId].uid == request.auth.uid
        && !(request.resource.data.courseId in get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data.get('completed', {}));
      allow update: if ok() && (
        // Student response: own session, from taught/clarification only, never to approved.
        (me().role == 'student' && resource.data.studentUid == request.auth.uid
          && resource.data.status in ['taught','clarification']
          && changed().hasOnly(['status','rating','resp','comment','revTopics','ackAt'])
          && request.resource.data.ackAt == request.time
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.resp in ['covered_ok','covered_revision','not_covered','clarify']
          && request.resource.data.status == (request.resource.data.resp == 'not_covered' ? 'disputed' : 'submitted'))
        ||
        // Faculty review: assigned faculty only, submitted/disputed only. Disputes and non-approvals need a note.
        (me().role == 'faculty' && resource.data.facultyUid == request.auth.uid
          && resource.data.status in ['submitted','disputed']
          && changed().hasOnly(['status','reviewNote','reviewedAt','reviewedBy','facRevTopics'])
          && request.resource.data.status in ['approved','rejected','clarification','revision']
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.reviewedBy == request.auth.uid
          && ((request.resource.data.status == 'approved' && resource.data.status == 'submitted'
                && resource.data.resp != 'clarify')
              || request.resource.data.reviewNote.size() > 0))
        ||
        // Admin reopen: mandatory reason; history stays in sessionEvents.
        (me().role == 'admin'
          && changed().hasOnly(['status','reopenReason','reopenedAt','reopenedBy'])
          && request.resource.data.status == 'taught'
          && request.resource.data.reopenReason.size() > 0
          && request.resource.data.reopenedAt == request.time
          && request.resource.data.reopenedBy == request.auth.uid));
      allow delete: if false;
    }
    // Append-only histories.
    match /sessionEvents/{e} {
      allow read: if ok() && (me().role == 'admin' || resource.data.studentUid == request.auth.uid
                     || resource.data.facultyUid == request.auth.uid);
      allow create: if ok() && request.resource.data.actorUid == request.auth.uid
                     && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /adminLogs/{l} {
      allow read: if role('admin');
      allow create: if role('admin') && request.resource.data.actorUid == request.auth.uid
                     && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /notifications/{n} {
      allow read: if ok() && resource.data.toUid == request.auth.uid;
      allow create: if ok();
      allow update: if ok() && resource.data.toUid == request.auth.uid && changed().hasOnly(['read']);
      allow delete: if false;
    }
  }
}
